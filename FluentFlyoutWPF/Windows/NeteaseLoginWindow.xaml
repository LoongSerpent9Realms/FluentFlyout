<controls:MicaWindow x:Class="FluentFlyoutWPF.Windows.NeteaseLoginWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:controls="clr-namespace:MicaWPF.Controls;assembly=MicaWPF"
                     Title="网易云扫码登录" Width="360" Height="470"
                     WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="28" HorizontalAlignment="Center">
        <TextBlock Text="网易云扫码登录" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock x:Name="StatusText" Text="正在生成二维码..." Margin="0,12,0,16" Opacity="0.7" HorizontalAlignment="Center" />
        <Border Width="260" Height="260" BorderBrush="#22000000" BorderThickness="1" Background="White">
            <Image x:Name="QrImage" Stretch="Uniform" Margin="10" />
        </Border>
        <Button Content="关闭" Width="90" Margin="0,22,0,0" Click="CloseButton_Click" />
    </StackPanel>
</controls:MicaWindow>
