<controls:MicaWindow x:Class="FluentFlyoutWPF.Windows.NeteaseLoginWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:controls="clr-namespace:MicaWPF.Controls;assembly=MicaWPF"
                     xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                     Title="网易云扫码登录" Width="520" Height="650"
                     WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="12">
        <wv2:WebView2 x:Name="LoginBrowser" />
        <TextBlock x:Name="StatusText" Text="正在加载网易云登录页面..." HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
    </Grid>
</controls:MicaWindow>
