<Window x:Class="FluentFlyoutWPF.Windows.LyricsDebugWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="歌词调试" Width="620" Height="420" WindowStartupLocation="CenterOwner">
    <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBox x:Name="DebugText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        <Button Grid.Row="1" Content="刷新" Width="90" Margin="0,12,0,0" HorizontalAlignment="Right" Click="Refresh_Click"/>
    </Grid>
</Window>
