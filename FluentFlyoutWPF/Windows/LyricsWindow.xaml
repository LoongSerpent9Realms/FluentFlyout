<Window x:Class="FluentFlyoutWPF.Windows.LyricsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="{DynamicResource LyricsWindowTitle}" Width="480" Height="174"
        MinWidth="340" MinHeight="130" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" Background="Transparent" AllowsTransparency="True" WindowStyle="None"
        ResizeMode="CanResize" Topmost="True" ShowActivated="False">
    <Border x:Name="LyricsSurface" Padding="16,12" CornerRadius="9" BorderBrush="#55FFFFFF" BorderThickness="1"
            MouseLeftButtonDown="WindowDrag_MouseLeftButtonDown"
            MouseEnter="LyricsBorder_MouseEnter" MouseLeave="LyricsBorder_MouseLeave">
      <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="2">
          <primitives:Thumb x:Name="DragHandleButton" Width="24" Height="24" Margin="0,2,6,2"
                            Visibility="Collapsed" DragDelta="DragHandle_DragDelta"
                            ToolTip="按住并拖动以移动桌面歌词" Cursor="SizeAll">
            <primitives:Thumb.Template>
              <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                <Border Background="#66000000">
                  <TextBlock Text="&#xE7C2;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="13"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </ControlTemplate>
            </primitives:Thumb.Template>
          </primitives:Thumb>
          <Button x:Name="LockButton" Width="28" Height="28" Visibility="Collapsed" Click="LockButton_Click"
                  ToolTip="锁定并开启鼠标穿透" Background="#55000000" BorderThickness="0" Foreground="White" FontSize="15" Padding="0">
            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
          <Button x:Name="CloseButton" Width="28" Height="28" Margin="6,0,0,0" Visibility="Collapsed" Click="CloseButton_Click"
                  ToolTip="关闭桌面歌词" Background="#55000000" BorderThickness="0" Foreground="White" FontSize="15" Padding="0">
            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
        </StackPanel>
        <StackPanel Margin="0,0,0,8">
            <TextBlock x:Name="SongTitleText" Foreground="White" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="SongArtistText" Foreground="#B8FFFFFF" Margin="0,2,0,0" FontSize="12" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Grid x:Name="LyricsLinesGrid" Grid.Row="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="0" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="CurrentLineText" Grid.RowSpan="3" Foreground="#FFFFFFFF" FontSize="19" FontWeight="SemiBold"
                     TextWrapping="Wrap" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     RenderTransformOrigin="0.5,0.5">
            <TextBlock.RenderTransform><TranslateTransform x:Name="CurrentLineOffset" /></TextBlock.RenderTransform>
          </TextBlock>
          <Border x:Name="LyricsDivider" Grid.Column="1" Grid.RowSpan="3" Width="1" Background="#44FFFFFF" />
          <TextBlock x:Name="NextLineText" Grid.Column="2" Grid.RowSpan="3" Foreground="#99FFFFFF" FontSize="15"
                     TextWrapping="Wrap" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     RenderTransformOrigin="0.5,0.5">
            <TextBlock.RenderTransform><TranslateTransform x:Name="NextLineOffset" /></TextBlock.RenderTransform>
          </TextBlock>
        </Grid>
      </Grid>
    </Border>
</Window>
